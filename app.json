{
  "expo": {
    "name": "Nouriva AI",
    "slug": "NourivaAI",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D3B26"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.productverse.nourivaai",
      "buildNumber": "15",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "Allow Nouriva AI to use Face ID to protect your account on this device.",
        "NSHealthShareUsageDescription": "Nouriva AI reads steps, heart rate, sleep, and weight from Apple Health to contextualize how meals fit your day.",
        "NSHealthUpdateUsageDescription": "Nouriva AI does not write data to Apple Health."
      },
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "package": "in.productverse.nourivaai",
      "versionCode": 26,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D3B26"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "react-native-health",
        {
          "healthSharePermission": "Nouriva AI reads steps, heart rate, sleep, and weight from Apple Health to contextualize how meals fit your day.",
          "healthUpdatePermission": "Nouriva AI does not write data to Apple Health."
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/crashlytics",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Nouriva AI to access your photos for your profile picture.",
          "cameraPermission": "Allow Nouriva AI to use your camera for a profile photo."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Nouriva AI to use Face ID to protect your account on this device."
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "enableProguardInReleaseBuilds": true,
            "enableMinifyInReleaseBuilds": true
          },
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.311592013058-135dku8t8d5s5d4ku5riojkbvi2k9dtf"
        }
      ],
      "./plugins/withFirebaseFix.js"
    ],
    "extra": {
      "eas": {
        "projectId": "8bcbaad3-ca11-49be-b328-124c79d8d1d5"
      }
    },
    "owner": "yogsb"
  }
}
