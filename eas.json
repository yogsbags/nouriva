{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "simulator": {
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal"
    },
    "android-apk": {
      "distribution": "internal",
      "environment": "production",
      "android": {
        "buildType": "apk"
      }
    },
    "android-aab": {
      "distribution": "internal",
      "environment": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "GRADLE_OPTS": "-Xmx16384m -XX:MaxMetaspaceSize=2048m"
      }
    },
    "production": {
      "environment": "production",
      "ios": {
        "credentialsSource": "local"
      }
    }
  },
  "submit": {
    "internal": {
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal",
        "releaseStatus": "draft"
      }
    },
    "closed": {
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "alpha",
        "releaseStatus": "draft"
      }
    },
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "production"
      },
      "ios": {
        "appleId": "yogesh@productverse.co.in",
        "ascAppId": "6763718713",
        "ascApiKeyPath": "./AuthKey_LSVW36Y7DX.p8",
        "ascApiKeyIssuerId": "14d492d2-a9bd-4fca-9708-2aa940e1e73b",
        "ascApiKeyId": "LSVW36Y7DX"
      }
    }
  }
}
